{
  "name": "@jfomhover/zotero-cli",
  "version": "0.1.3",
  "description": "A secure, read-only CLI for the Zotero Web API",
  "type": "module",
  "bin": {
    "zotero": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.js\"",
    "test": "npm run build && node --test test/*.test.js",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
